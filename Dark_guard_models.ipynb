            "CUDA available: True\n",
            "GPU name: Tesla T4\n",
            "\n",
            "Sample keys: dict_keys(['input_ids', 'token_type_ids', 'attention_mask', 'labels'])\n",
            "input_ids shape: torch.Size([64])\n",
