{
  "manifest_version": 3,
  "name": "Dark-Guard",
  "version": "1.0.0",
  "description": "AI-powered dark pattern detector for shopping websites.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Dark-Guard"
  }
}